# Copy to .env and fill in. Never commit .env.
# Optional: without a key the feed is sorted by your votes alone
GEMINI_API_KEY=your-gemini-api-key
# Optional, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
# Optional, defaults to ./data (the database goes here)
# DATA_DIR=./data
# Optional: minutes between fetches; 0 in RUN_FETCHER turns fetching off
# REFRESH_MINUTES=20
# RUN_FETCHER=1
# Optional: days unvoted stories are kept
# KEEP_DAYS=14
# Optional: stories scoring below this (0-100) are folded away
# HIDE_BELOW=35
